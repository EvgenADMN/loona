# Copy to .env and fill in the empty secrets; docker compose refuses to start
# without them.  Generate each with:  openssl rand -hex 32
#
# For development with runserver, set LOONA_DEBUG=true as well: error pages
# with tracebacks, static files from runserver, and a built-in secret key when
# LOONA_SECRET_KEY is empty. Never in production.
LOONA_DEBUG=false
LOONA_SECRET_KEY=
# The name people open Loona by (comma-separated). Unset: localhost only, or
# anything with LOONA_DEBUG=true.
LOONA_ALLOWED_HOSTS=localhost,127.0.0.1

# Behind an HTTPS reverse proxy:
# LOONA_HTTPS=true                 cookies over HTTPS only
# LOONA_TRUST_PROXY=true           believe the proxy's X-Forwarded-Proto
# LOONA_HSTS_SECONDS=31536000      Strict-Transport-Security; once sent, hard to take back

# PostgreSQL. docker compose starts it as the "db" service with this password.
LOONA_DB_PASSWORD=
# The Celery broker's password in compose. Hex only: openssl rand -hex 24
LOONA_REDIS_PASSWORD=
# How Loona run on the host (runserver, tests) reaches that database:
# LOONA_DATABASE_URL=postgres://loona:<LOONA_DB_PASSWORD>@127.0.0.1:5432/loona

# Container only: create this admin on first start (docker compose).
# LOONA_ADMIN_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=
# LOONA_PORT=8080
# The address the port is published on. Only this machine by default, for a
# reverse proxy here; 0.0.0.0 opens it to the network.
# LOONA_BIND=127.0.0.1
# LOONA_CSRF_TRUSTED_ORIGINS=https://loona.example.com

# Encrypts credential secrets at rest - set it, so that LOONA_SECRET_KEY alone
# does not open them. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without it, the key is derived from LOONA_SECRET_KEY.  Set it before the
# first secret is stored: changing it later makes the stored ones unreadable.
LOONA_SECRET_STORE_KEY=

# "thread" runs playbooks inside the web process - fine for development.
# "celery" hands them to a worker; needs the broker below and a running worker.
LOONA_RUNNER_MODE=thread
LOONA_BROKER_URL=redis://localhost:6379/0

LOONA_TIME_ZONE=UTC
LOONA_LOG_LEVEL=INFO
# LOONA_DATA_DIR=/var/lib/loona/jobs
# LOONA_MAX_JOB_EVENTS=5000

# --- LDAP / Active Directory (off while LOONA_LDAP_SERVER_URI is empty) ------
# Easier: leave these alone and set LDAP up in Administration -> Authentication,
# which takes over from them once switched on.
# Every directory group a user is in, nested ones included, becomes a Loona
# team at sign-in; grant those teams roles on host groups in Admin -> Groups.
# Local accounts keep working alongside, so keep a local superuser around.
LOONA_LDAP_SERVER_URI=
# LOONA_LDAP_START_TLS=false
# LOONA_LDAP_VERIFY_TLS=true
# LOONA_LDAP_CA_FILE=/etc/ssl/certs/corp-ca.pem
# LOONA_LDAP_BIND_DN=cn=loona,ou=services,dc=example,dc=org
# LOONA_LDAP_BIND_PASSWORD=
# LOONA_LDAP_USER_BASE=ou=people,dc=example,dc=org
# LOONA_LDAP_USER_FILTER=(uid={username})          # AD: (sAMAccountName={username})
# LOONA_LDAP_USERNAME_ATTR=uid                     # AD: sAMAccountName
# LOONA_LDAP_GROUP_BASE=ou=groups,dc=example,dc=org
# LOONA_LDAP_GROUP_NAME_ATTR=cn
# "all" turns every directory group into a team; "mapped" only honours groups
# already linked to a team in Admin -> Directory groups.
# LOONA_LDAP_MIRROR_GROUPS=all
# Group DNs. Leaving the group takes the flag away at the next sign-in.
# LOONA_LDAP_REQUIRE_GROUP=cn=loona-users,ou=groups,dc=example,dc=org
# LOONA_LDAP_SUPERUSER_GROUP=cn=loona-admins,ou=groups,dc=example,dc=org
# LOONA_LDAP_STAFF_GROUP=
# Minutes between re-checks of a signed-in directory user (removed users are signed out).
# LOONA_LDAP_RECHECK_MINUTES=15
