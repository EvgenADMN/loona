msgstr "DN"

#: access/models.py:81
msgid "Lower-cased DN."
msgstr "DN в нижнем регистре."

#: access/models.py:91
msgid "Members of this directory group join this team."
msgstr "Участники этой группы каталога попадают в эту команду."

#: access/models.py:140
msgid "Mon"
msgstr "Пн"

#: access/models.py:140
msgid "Tue"
msgstr "Вт"

#: access/models.py:140
msgid "Wed"
msgstr "Ср"

#: access/models.py:140
msgid "Thu"
msgstr "Чт"

#: access/models.py:140
msgid "Fri"
msgstr "Пт"

