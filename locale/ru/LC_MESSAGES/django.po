#, python-brace-format
msgid "Active Directory: (sAMAccountName={username})"
msgstr "Active Directory: (sAMAccountName={username})"

#: administration/models.py:99
msgid "Login attribute"
msgstr "Атрибут логина"

#: administration/models.py:100
msgid "Mail attribute"
msgstr "Атрибут почты"

#: administration/models.py:101
msgid "First name attribute"
msgstr "Атрибут имени"

#: administration/models.py:102
msgid "Last name attribute"
msgstr "Атрибут фамилии"

#: administration/models.py:103
msgid "Groups under"
msgstr "Группы в"

#: administration/models.py:105
msgid "Group filter"
msgstr "Фильтр групп"

#: administration/models.py:109
msgid "Group name attribute"
msgstr "Атрибут имени группы"

#: administration/models.py:110 administration/models.py:152
msgid "Teams from groups"
msgstr "Команды из групп"

#: administration/models.py:112 administration/models.py:154
msgid "Only members of"
msgstr "Только участники"

#: administration/models.py:113
msgid "Group DN. Empty lets any directory user in."
msgstr "DN группы. Пусто - пускать любого пользователя каталога."

#: administration/models.py:114 administration/models.py:156
msgid "Superusers are members of"
msgstr "Суперпользователи - участники"

#: administration/models.py:116
msgid "Staff are members of"
msgstr "Персонал - участники"

#: administration/models.py:118
msgid "Re-check signed-in users every, minutes"
msgstr "Перепроверять вошедших пользователей каждые, минут"

#: administration/models.py:119
msgid "Someone removed from the directory is signed out at the next re-check."
msgstr ""
"Удалённый из каталога пользователь будет разлогинен при следующей проверке."

#: administration/models.py:124
msgid "Off"
msgstr "Выключен"

#: administration/models.py:124 templates/administration/sso.html:17
msgid "OpenID Connect"
msgstr "OpenID Connect"

#: administration/models.py:124 templates/administration/sso.html:27
msgid "SAML 2.0"
msgstr "SAML 2.0"

#: administration/models.py:125 templates/administration/_nav.html:5
msgid "Single sign-on"
msgstr "Единый вход"

#: administration/models.py:128
msgid "Button"
msgstr "Кнопка"

#: administration/models.py:129
msgid "What the sign-in page offers, e.g. \"Sign in with Keycloak\"."
msgstr "Что предлагает страница входа, например «Войти через Keycloak»."

#: administration/models.py:132
msgid "Issuer"
msgstr "Issuer"

#: administration/models.py:133
msgid ""
"e.g. https://keycloak.corp.local/realms/main - Loona reads /.well-known/"
"openid-configuration under it."
msgstr ""
"например, https://keycloak.corp.local/realms/main - Loona читает /.well-"
"known/openid-configuration под этим адресом."

#: administration/models.py:136
msgid "Client ID"
msgstr "Client ID"

#: administration/models.py:138
msgid "Scopes"
msgstr "Scopes"

#: administration/models.py:139
msgid "Add the one your provider needs for groups, if any."
msgstr ""
"Добавьте тот, который нужен вашему провайдеру для групп, если такой есть."

#: administration/models.py:141
msgid "Identity provider metadata"
msgstr "Метаданные провайдера (IdP)"

#: administration/models.py:142
msgid ""
"The IdP's metadata XML, pasted. Its signing certificate is what Loona trusts."
msgstr ""
"XML-метаданные IdP, вставленные целиком. Loona доверяет сертификату подписи "
"из них."

#: administration/models.py:145
msgid "Username from"
msgstr "Имя пользователя из"

#: administration/models.py:146
msgid ""
"Claim or attribute. Empty: preferred_username (OIDC), the NameID (SAML)."
msgstr "Claim или атрибут. Пусто - preferred_username (OIDC), NameID (SAML)."

#: administration/models.py:148
msgid "Email from"
msgstr "Email из"

#: administration/models.py:149
msgid "First name from"
msgstr "Имя из"

#: administration/models.py:150
msgid "Last name from"
msgstr "Фамилия из"

#: administration/models.py:151
msgid "Groups from"
msgstr "Группы из"

#: administration/models.py:155
msgid "Group name. Empty lets anyone the provider vouches for in."
msgstr "Имя группы. Пусто - пускать любого, за кого ручается провайдер."

#: administration/models.py:159
msgid "Take over existing accounts with the same username"
msgstr "Забирать существующие учётные записи с тем же именем"

#: administration/models.py:160
msgid ""
"Off: a sign-in whose username a local or LDAP account already has is "
"refused. On: it becomes that account - but never a superuser, nor an "
"account with a password or one-time codes of its own."
msgstr ""
"Выключено - вход с именем, которое уже занято локальной или LDAP-учёткой, "
"отклоняется. Включено - он становится этой учёткой, но никогда - "
"суперпользователем или учёткой со своим паролем или одноразовыми кодами."

#: administration/models.py:167
msgid "Whoever turns it on"
msgstr "Кто сам включил"

#: administration/models.py:168
msgid "Required for superusers"
msgstr "Обязательно для суперпользователей"

#: administration/models.py:169
msgid "Required for everyone"
msgstr "Обязательно для всех"

#: administration/models.py:172 templates/administration/user_form.html:19
#: templates/signin/security.html:16
msgid "One-time codes"
msgstr "Одноразовые коды"

#: administration/models.py:173
msgid ""
"For sign-ins with a password - local or LDAP. Whoever it covers and has "
"none, you included, is sent to set them up at once. Single sign-on leaves "
"this to the identity provider."
msgstr ""
"Для входа по паролю - локальному или LDAP. Всех, кого это касается и у кого "
"кодов нет (включая вас), сразу отправят их настроить. При едином входе это "
"решает провайдер."

#: administration/models.py:179
msgid "STARTTLS"
msgstr "STARTTLS"

#: administration/models.py:179
msgid "SSL/TLS"
msgstr "SSL/TLS"

#: administration/models.py:179
msgid "None"
msgstr "Нет"

#: administration/models.py:180
msgid "SMTP server"
msgstr "SMTP-сервер"

#: administration/models.py:181
msgid "SMTP port"
msgstr "Порт SMTP"

#: administration/models.py:182
msgid "Security"
msgstr "Защита"

#: administration/models.py:184
msgid "SMTP login"
msgstr "Логин SMTP"

#: administration/models.py:186
msgid "From address"
msgstr "Адрес отправителя"

#: administration/models.py:187
msgid "e.g. \"Loona <loona@corp.local>\""
msgstr "например, «Loona <loona@corp.local>»"

#: administration/models.py:190
msgid "AppRole"
msgstr "AppRole"

#: administration/models.py:192
msgid "Vault address"
msgstr "Адрес Vault"

#: administration/models.py:193
msgid ""
"e.g. https://vault.corp.local:8200. Empty: secrets cannot refer to Vault."
msgstr ""
"например, https://vault.corp.local:8200. Пусто - секреты не могут ссылаться "
"на Vault."

#: administration/models.py:195
msgid "Namespace"
msgstr "Namespace"

#: administration/models.py:196
msgid "Vault Enterprise / HCP only."
msgstr "Только Vault Enterprise / HCP."

#: administration/models.py:197
msgid "Sign in with"
msgstr "Вход через"

#: administration/models.py:199
msgid "AppRole mount"
msgstr "Путь AppRole"

#: administration/models.py:200
msgid "Role ID"
msgstr "Role ID"

#: administration/models.py:205
msgid "PEM, if Vault's certificate comes from your own CA."
msgstr "PEM, если сертификат Vault выдан вашим собственным CA."

#: administration/models.py:209
msgid "Paths others may refer to"
msgstr "Пути, на которые могут ссылаться остальные"

#: administration/models.py:210
#, python-brace-format
msgid ""
