msgstr "Сб"

#: access/models.py:140
msgid "Sun"
msgstr "Вс"

#: access/models.py:159
msgid "0 = Monday ... 6 = Sunday."
msgstr "0 = понедельник ... 6 = воскресенье."

#: access/models.py:161
msgid ""
"At or before the start: the window runs past midnight into the next day."
msgstr "Не позже начала: окно продолжается после полуночи на следующий день."

#: access/views.py:38
#, python-format
msgid "Team %(team)s created."
msgstr "Команда %(team)s создана."

#: access/views.py:60
#, python-format
msgid "Team %(name)s deleted."
msgstr "Команда %(name)s удалена."

#: access/views.py:120
#, python-format
msgid ""
"%(user)s is in %(team)s through LDAP and would be back at the next sign-in. "
"Take them out of the LDAP group instead."
msgstr ""
"%(user)s состоит в %(team)s через LDAP и вернётся при следующем входе. "
"Уберите пользователя из группы LDAP."

#: access/views.py:160
msgid "Members move over the next time each of them signs in."
msgstr "Участники перейдут при следующем входе каждого из них."

#: access/views.py:170
msgid "Members leave the team the next time each of them signs in."
msgstr "Участники покинут команду при следующем входе каждого из них."

#: access/views.py:218
#, python-format
msgid "Maintenance window removed from %(group)s."
msgstr "Окно обслуживания удалено из %(group)s."

#: administration/forms.py:50
msgid "Starts with http:// or https://."
msgstr "Начинается с http:// или https://."

#: administration/forms.py:56
msgid "Between 1 hour and 90 days."
msgstr "От 1 часа до 90 дней."

#: administration/forms.py:65
#, python-format
msgid "Not a module name: %(join)s."
msgstr "Не название модуля: %(join)s."

#: administration/forms.py:71
msgid "Between 10 seconds and an hour."
msgstr "От 10 секунд до часа."

#: administration/forms.py:77
msgid "Service account password"
msgstr "Пароль служебной учётной записи"

#: administration/forms.py:80
msgid "Leave empty to keep the stored password."
msgstr "Оставьте пустым, чтобы сохранить текущий пароль."

#: administration/forms.py:83
msgid "Try a user"
msgstr "Проверить пользователя"

#: administration/forms.py:85
msgid "For Test connection: see which groups and teams this login would get."
msgstr "Для проверки подключения: какие группы и команды получит этот логин."

#: administration/forms.py:102 administration/forms.py:344
#: administration/forms.py:351 administration/forms.py:355
msgid "Needed to sign anyone in."
msgstr "Нужно, чтобы кто-либо мог войти."

#: administration/forms.py:105
msgid "Starts with ldap:// or ldaps://."
msgstr "Начинается с ldap:// или ldaps://."

#: administration/forms.py:107
#, python-brace-format
msgid "Must contain {username}."
msgstr "Должен содержать {username}."

#: administration/forms.py:154
msgid "Group DN"
msgstr "DN группы"

#: administration/forms.py:181
msgid "Superuser - may do anything, including Administration"
msgstr "Суперпользователь - может всё, включая администрирование"

#: administration/forms.py:205
msgid "Teams the directory manages for this user are kept as they are."
msgstr ""
"Команды, которыми для этого пользователя управляет каталог, остаются как "
"есть."

#: administration/forms.py:208
msgid "New password"
msgstr "Новый пароль"

#: administration/forms.py:209
msgid "Local accounts only. Leave empty to keep the current one."
msgstr ""
"Только для локальных учётных записей. Оставьте пустым, чтобы сохранить "
"текущий."

#: administration/forms.py:215
msgid "Can sign in"
msgstr "Может входить"

#: administration/forms.py:215
msgid "Superuser"
msgstr "Суперпользователь"

#: administration/forms.py:234
msgid "You cannot lock yourself out."
msgstr "Нельзя заблокировать самого себя."

#: administration/forms.py:240
msgid "You cannot take your own superuser rights away."
msgstr "Нельзя снять с себя права суперпользователя."

#: administration/forms.py:243
msgid "This is the last active superuser; nobody could administer Loona."
msgstr ""
"Это последний активный суперпользователь: никто не смог бы администрировать "
"Loona."

#: administration/forms.py:262 administration/models.py:190
msgid "Token"
msgstr "Токен"

#: administration/forms.py:263
msgid "Leave empty to keep the stored token."
msgstr "Оставьте пустым, чтобы сохранить текущий токен."

#: administration/forms.py:266
msgid "Secret ID"
msgstr "Secret ID"

#: administration/forms.py:267
msgid "Leave empty to keep the stored Secret ID."
msgstr "Оставьте пустым, чтобы сохранить текущий Secret ID."

#: administration/forms.py:270
msgid "Try a reference"
msgstr "Проверить ссылку"

#: administration/forms.py:271
msgid ""
"For Test connection: path#key to read, e.g. secret/data/app#password. Only "
"whether it worked is shown."
msgstr ""
"Для проверки подключения: путь#ключ для чтения, например secret/data/"
"app#password. Показывается только, получилось ли."

#: administration/forms.py:291 administration/forms.py:347
msgid "Starts with https:// (or http:// for a test server)."
msgstr "Начинается с https:// (или http:// для тестового сервера)."

#: administration/forms.py:294
msgid "AppRole needs a Role ID."
msgstr "Для AppRole нужен Role ID."

#: administration/forms.py:324
msgid "Client secret"
msgstr "Секрет клиента"

#: administration/forms.py:325
msgid "Leave empty to keep the stored secret."
msgstr "Оставьте пустым, чтобы сохранить текущий секрет."

#: administration/forms.py:349
msgid "OpenID Connect needs the openid scope."
msgstr "Для OpenID Connect нужен scope openid."

#: administration/forms.py:362
#, python-format
msgid "Cannot read it: %(error)s"
msgstr "Не удаётся прочитать: %(error)s"

#: administration/forms.py:365
msgid "It names no single sign-on address."
msgstr "В них нет адреса единого входа."

#: administration/forms.py:367
msgid "It has no signing certificate."
msgstr "В них нет сертификата подписи."

#: administration/models.py:22
msgid "Everyone with a local account"
msgstr "Все с локальной учётной записью"

#: administration/models.py:23
msgid "Superusers only (the break-glass account)"
msgstr "Только суперпользователи (аварийный доступ)"

#: administration/models.py:28
msgid "Every directory group becomes a team"
msgstr "Каждая группа каталога становится командой"

#: administration/models.py:29
msgid "Only groups mapped to a team below"
msgstr "Только группы, сопоставленные с командой ниже"

#: administration/models.py:35
msgid "Shown next to the logo, e.g. \"Production\" or \"Lab\"."
msgstr "Показывается рядом с логотипом, например «Прод» или «Лаборатория»."

#: administration/models.py:39
msgid "The interface language for everyone."
msgstr "Язык интерфейса по умолчанию; каждый может выбрать свой."

#: administration/models.py:42
msgid "How long a sign-in lasts before asking again."
msgstr "Сколько длится вход до повторного запроса."

#: administration/models.py:46
msgid "Once LDAP is in charge, keep local accounts for emergencies only."
msgstr ""
"Когда входом управляет LDAP, оставьте локальные учётные записи только на "
"крайний случай."

#: administration/models.py:50
msgid "The approval rule a new host group starts with."
msgstr "Правило одобрения для новых групп хостов."

#: administration/models.py:54 templates/notifications/overview.html:11
msgid "Loona's address"
msgstr "Адрес Loona"

#: administration/models.py:55
msgid ""
"How people reach this Loona, e.g. https://loona.corp.local - used for links "
"in notifications."
msgstr ""
"Адрес, по которому люди открывают эту Loona, например https://loona.corp."
"local - для ссылок в уведомлениях."

#: administration/models.py:61
msgid "Delete finished runs older than this. 0 keeps them all."
msgstr "Удалять завершённые запуски старше этого срока. 0 - хранить все."

#: administration/models.py:64
msgid "Log lines kept per run. 0 keeps them all."
msgstr "Сколько строк лога хранить на запуск. 0 - все."

#: administration/models.py:67
msgid "How long a new machine gets to start accepting SSH."
msgstr "Сколько времени даётся новой машине, чтобы начать принимать SSH."

#: administration/models.py:70
msgid "Modules for ad-hoc commands"
msgstr "Модули для разовых команд"

#: administration/models.py:74
msgid ""
"One per line; empty turns ad-hoc commands off. Modules that read or write "
"files on the Loona server (copy, template, script, fetch, ...) stay "
"superuser-only even when listed."
msgstr ""
"По одному в строке; пусто - разовые команды выключены. Модули, которые "
"читают или пишут файлы на сервере Loona (copy, template, script, "
"fetch, ...), даже в списке доступны только суперпользователям."

#: administration/models.py:80
msgid "Build editor forms for every installed module from ansible-doc."
msgstr ""
"Построить формы редактора для всех установленных модулей из ansible-doc."

#: administration/models.py:84
msgid "Sign in with LDAP"
msgstr "Вход через LDAP"

#: administration/models.py:85
msgid "Server"
msgstr "Сервер"

#: administration/models.py:86
msgid "ldap://dc1.corp.local or ldaps://dc1.corp.local:636"
msgstr "ldap://dc1.corp.local или ldaps://dc1.corp.local:636"

#: administration/models.py:87
msgid "StartTLS"
msgstr "StartTLS"

#: administration/models.py:88 administration/models.py:202
msgid "Verify the server certificate"
msgstr "Проверять сертификат сервера"

#: administration/models.py:90 administration/models.py:204
msgid "CA certificate"
msgstr "Сертификат CA"

#: administration/models.py:91
msgid "PEM, if the server's certificate is signed by a private CA."
msgstr "PEM, если сертификат сервера подписан собственным CA."

#: administration/models.py:93 administration/models.py:207
msgid "Timeout, seconds"
msgstr "Таймаут, секунды"

#: administration/models.py:94
msgid "Service account DN"
msgstr "DN служебной учётной записи"

#: administration/models.py:96
msgid "Users under"
msgstr "Пользователи в"

#: administration/models.py:97
msgid "User filter"
msgstr "Фильтр пользователей"

