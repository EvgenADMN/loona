#: inventory/forms.py
#, python-format
msgid "Only a superuser may set Ansible's own variables: %(join)s."
msgstr "Только суперпользователь может задавать собственные переменные Ansible: %(join)s."

#: inventory/forms.py
#, python-format
msgid "Only a superuser may use templates in variables: %(join)s."
msgstr "Только суперпользователь может использовать шаблоны в переменных: %(join)s."

#: inventory/forms.py
#, python-format
msgid "This host logs in with %(credential)s, which is not shared with you. Choose another credential to move it to a new address."
msgstr "Этот хост входит с учёткой %(credential)s, которой с вами не поделились. Чтобы перенести его на новый адрес, выберите другую учётку."

#: inventory/forms.py infra/models.py
msgid "Letters, digits, dot, dash and underscore, not starting with a digit."
msgstr "Буквы, цифры, точка, дефис и подчёркивание; не с цифры."

#: inventory/views.py
#, python-format
msgid "This host logs in with %(credential)s, which is not shared with you; ask its owner to forget the key."
msgstr "Этот хост входит с учёткой %(credential)s, которой с вами не поделились; попросите её владельца сбросить ключ."

#: inventory/views.py
#, python-format
msgid "Not checked: this host logs in with %(credential)s, which is not shared with you."
msgstr "Не проверено: этот хост входит с учёткой %(credential)s, которой с вами не поделились."

#: inventory/views.py
msgid "Type a login and password to try the new address with those instead."
msgstr "Введите логин и пароль, чтобы проверить новый адрес с ними."

#: secretstore/forms.py
msgid "Only a superuser may name a secret after one of Ansible's own variables, other than its passwords."
msgstr "Только суперпользователь может назвать секрет как собственную переменную Ansible, кроме паролей."

#: signin/sso.py
#, python-format
msgid "An account named %(name)s already exists in Loona and signs in on its own; single sign-on does not take such accounts over."
msgstr "Учётка %(name)s уже есть в Loona и входит сама; единый вход такие учётки не забирает."
